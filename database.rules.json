{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": true,
      ".indexOn": ["elo", "soloDone"],
      "$uid": {
        "name": {
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
        }
      }
    },

    "queue": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".validate": "newData.hasChildren(['name', 'at'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "elo": { ".validate": false },
        "$other": { ".validate": false }
      }
    },

    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()"
      }
    },

    "paths": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/players/' + $uid).exists() && root.child('rooms/' + $code + '/status').val() === 'playing'",
          ".validate": "newData.hasChildren()"
        }
      }
    },

    "daily": {
      "$date": {
        "opensAt": { ".read": true },
        "closesAt": { ".read": "root.child('daily/' + $date + '/opensAt').val() <= now" },
        "n": { ".read": "root.child('daily/' + $date + '/opensAt').val() <= now" },
        "start": { ".read": "root.child('daily/' + $date + '/closesAt').val() <= now || (auth != null && root.child('dailyRuns/' + $date + '/' + auth.uid + '/startedAt').exists())" },
        "target": { ".read": "root.child('daily/' + $date + '/closesAt').val() <= now || (auth != null && root.child('dailyRuns/' + $date + '/' + auth.uid + '/startedAt').exists())" }
      }
    },

    "dailyRuns": {
      "$date": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "name": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('daily/' + $date + '/opensAt').val() <= now && now < root.child('daily/' + $date + '/closesAt').val()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          },
          "startedAt": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('daily/' + $date + '/opensAt').val() <= now && now < root.child('daily/' + $date + '/closesAt').val()",
            ".validate": "newData.val() === now"
          },
          "finishedAt": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('dailyRuns/' + $date + '/' + $uid + '/startedAt').exists() && !root.child('dailyRuns/' + $date + '/' + $uid + '/gaveUp').exists()",
            ".validate": "newData.val() === now"
          },
          "gaveUp": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('dailyRuns/' + $date + '/' + $uid + '/startedAt').exists() && !root.child('dailyRuns/' + $date + '/' + $uid + '/finishedAt').exists()",
            ".validate": "newData.val() === true"
          },
          "path": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('dailyRuns/' + $date + '/' + $uid + '/startedAt').exists()",
            ".validate": "newData.hasChildren()"
          },
          "times": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('dailyRuns/' + $date + '/' + $uid + '/startedAt').exists()",
            ".validate": "newData.hasChildren()"
          }
        }
      }
    },

    "dailyScores": {
      "$date": {
        ".read": true,
        ".indexOn": ["time"]
      }
    },

    "errors": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['msg', 'uid', 'at']) && newData.child('uid').val() === auth.uid && newData.child('at').val() === now",
        "msg": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "src": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "line": { ".validate": "newData.isNumber()" },
        "col": { ".validate": "newData.isNumber()" },
        "stack": { ".validate": "newData.isString() && newData.val().length <= 1500" },
        "clientAt": { ".validate": "newData.isNumber()" },
        "uid": { ".validate": "newData.isString()" },
        "ua": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "page": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "screen": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "purchases": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "pathTimes": {
      "$code": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/players/' + $uid).exists() && root.child('rooms/' + $code + '/status').val() === 'playing'",
          ".validate": "newData.hasChildren()"
        }
      }
    },

    "history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('users/' + $uid + '/premium').val() === true",
        ".indexOn": ["at"],
        "$key": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('mode').val() === 'solo'",
          ".validate": "newData.hasChildren(['at', 'mode', 'start', 'target', 'clicks', 'path', 'finished'])",
          "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "mode": { ".validate": "newData.val() === 'solo'" },
          "start": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "target": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "clicks": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
          "time": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "path": { ".validate": "newData.hasChildren()" },
          "finished": { ".validate": "newData.isBoolean()" },
          "won": { ".validate": "newData.isBoolean()" },
          "gaveUp": { ".validate": "newData.isBoolean()" },
          "opponents": { ".validate": "newData.hasChildren()" },
          "challengeTime": { ".validate": "newData.isNumber()" },
          "daily": { ".validate": "newData.isString() && newData.val().length === 10" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "$other": { ".validate": false }
        }
      }
    },

    "results": {
      "$code": {
        ".read": "auth != null"
      }
    },

    "quizRooms": {
      ".indexOn": ["createdAt"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
        "hostId": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'done'" },
        "g": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "seed": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "startAt": { ".validate": "newData.isNumber()" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && data.parent().parent().child('hostId').exists()",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "online": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "a": {
              "$g": {
                "$i": {
                  ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['p', 's'])",
                  "p": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 3" },
                  "t": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
                  "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
                  "$other": { ".validate": false }
                }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "quizSolo": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['at', 'score', 'ok'])",
          "at": { ".validate": "newData.val() === now" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "ok": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "$other": { ".validate": false }
        }
      }
    },

    "quizDaily": {
      "$date": {
        ".read": true,
        ".indexOn": ["score"],
        "$uid": {
          ".validate": "$date.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)",
          "name": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && !data.exists()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
          },
          "startedAt": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === now"
          },
          "res": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && !data.exists() && data.parent().child('startedAt').exists()",
            ".validate": "newData.hasChildren(['score', 'ok', 'marks', 'at']) && newData.child('at').val() === now && now - data.parent().child('startedAt').val() <= 300000",
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "ok": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
            "marks": { ".validate": "newData.isString() && newData.val().matches(/^[01]{10}$/)" },
            "ms": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "score": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && !data.exists() && newData.parent().child('res').exists()",
            ".validate": "newData.isNumber() && newData.val() === newData.parent().child('res/score').val()"
          },
          "$other": { ".validate": false }
        }
      }
    },

    "rooms": {
      ".indexOn": ["createdAt"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('hostId').val() === auth.uid && newData.child('ranked').val() !== true) || data.child('hostId').val() === auth.uid)",
        "ranked": {
          ".validate": "newData.isBoolean() && (!data.exists() || data.val() === newData.val())"
        },
        "status": {
          ".write": "auth != null && data.val() === 'playing' && newData.val() === 'done' && data.parent().child('players').child(auth.uid).exists()",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'done'"
        },
        "winnerId": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('players').child(auth.uid).exists()",
          ".validate": "!data.exists() && newData.isString() && newData.parent().child('players').child(newData.val()).child('finishedAt').exists()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostId').exists() && (data.parent().parent().child('ranked').val() !== true || auth.token.firebase.sign_in_provider !== 'anonymous')",
            ".validate": "auth.uid === $uid || (!newData.child('path').child('1').exists() && !newData.child('finishedAt').exists() && newData.child('name').val() === data.child('name').val())",
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "online": { ".validate": "newData.isBoolean()" },
            "gaveUp": { ".validate": "newData.isBoolean()" },
            "finishedAt": { ".validate": "newData.isNumber()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "clicks": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
            "path": { ".validate": "(newData.hasChildren() || newData.isString()) && root.child('rooms/' + $code + '/ranked').val() !== true" }
          }
        }
      }
    }
  }
}
